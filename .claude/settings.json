{
  "permissions": {
    "allow": [
      "mcp__xcode",
      "mcp__xcode-tools",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(xcodebuild *)",
      "Bash(xcbeautify *)",
      "Bash(scripts/quality*)",
      "Bash(scripts/tests/run*)",
      "Bash(scripts/doctor*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(SKIP_QUALITY=*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["xcode"],
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "swiftui-expert@swiftui-expert-skill": false,
    "swift-concurrency@swift-concurrency-agent-skill": true,
    "swift-testing-expert@swift-testing-agent-skill": true,
    "swift-api-design-guidelines@swift-api-design-guidelines-skill": false
  }
}
