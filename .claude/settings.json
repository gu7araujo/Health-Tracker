{
  "permissions": {
    "allow": [
      "mcp__xcode",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(xcbeautify *)",
      "Bash(scripts/quality*)",
      "Bash(scripts/tests/run*)",
      "Bash(scripts/doctor*)",
      "Bash(scripts/bootstrap*)",
      "Bash(scripts/fitness/*)",
      "Bash(xcrun simctl *)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(SKIP_QUALITY=*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(sudo *)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|mcp__xcode__XcodeWrite|mcp__xcode__XcodeUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh; [ ! -x \"$hook\" ] || \"$hook\""
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["xcode"],
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "swiftui-expert@swiftui-expert-skill": false,
    "swift-concurrency@swift-concurrency-agent-skill": true,
    "swift-testing-expert@swift-testing-agent-skill": true,
    "swift-api-design-guidelines@swift-api-design-guidelines-skill": false
  }
}
