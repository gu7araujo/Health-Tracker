{
  "permissions": {
    "allow": [
      "mcp__xcode",
      "Bash(rocketsim *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(xcodebuild *)",
      "Bash(xcbeautify *)"
    ]
  },
  "enabledPlugins": {
    "swiftui-expert@swiftui-expert-skill": true,
    "swift-concurrency@swift-concurrency-agent-skill": true,
    "swift-testing-expert@swift-testing-agent-skill": true,
    "swift-api-design-guidelines@swift-api-design-guidelines-skill": true
  }
}
