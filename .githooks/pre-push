#!/usr/bin/env bash
# Refuses pushes to main, warns (never blocks) if the persisted JSON shape changed since
# origin/main without a migration, then runs the quality gate (scripts/quality --fast,
# or $QUALITY_CMD). SKIP_QUALITY=1 skips the gate.
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push to main. Push a branch and open a pull request." >&2
    exit 1
  fi
done

cd "$(git rev-parse --show-toplevel)"

# Warn-only: the guard exits 0 and only notes a missing origin/main; `|| true` keeps the push unblocked.
if [ -x scripts/fitness/persisted-shape-guard.sh ]; then
  scripts/fitness/persisted-shape-guard.sh origin/main </dev/null >&2 || true
fi

if [ "${SKIP_QUALITY:-}" = "1" ]; then
  echo "pre-push: ⚠️  SKIP_QUALITY=1, skipping the quality gate: CI re-runs the gate only on an open PR, and not on docs-only changes." >&2
  exit 0
fi

eval "${QUALITY_CMD:-scripts/quality --fast}"
