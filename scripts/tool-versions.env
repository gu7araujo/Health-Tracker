# Pinned tool versions. CI installs exactly these; scripts/doctor checks them locally.
# The sha256s are of the release archives install-tools.sh fetches (macOS and Linux assets).
SWIFTLINT_VERSION=0.65.0
SWIFTLINT_SHA256_MACOS=d6cb0aa7a2f5f1ef306fc9e37bcb54dc9a26facc8f7784ac0c3dd3eccf5c6ba6
SWIFTLINT_SHA256_LINUX=79306a34e5c7cc55a220cd108cbb861dcad5f10138dcdf261e2624ae8b0a486b
SWIFTFORMAT_VERSION=0.61.1
SWIFTFORMAT_SHA256_MACOS=b990400779aceb7d7020796eb9ba814d4480543f671d38fc0ff48cb72f04c584
SWIFTFORMAT_SHA256_LINUX=7bc8706e3fd51963f1f29eb99098ebdf482f3497fa527c68e6cf75cbee29c77a
XCODE_VERSION=27.2
# The iPhone model scripts/quality tests on: on both iOS 26.5 locally and CI's iOS 27.0 (xcode-27 image).
SIMULATOR_DEVICE="iPhone 17"
# macOS only; the sha256 is of the release zip periphery-$PERIPHERY_VERSION.zip.
PERIPHERY_VERSION=3.8.0
PERIPHERY_SHA256=07d4e286e31dd79164df39097e0b59f533c94badbe18158464a455ea88a166d7
# macOS, local only (swift-lsp's build server; CI runs no LSP). Pure Python with no release assets,
# so the sha256 is of the tag's source archive v$XCODE_BUILD_SERVER_VERSION.tar.gz (the one Homebrew pins).
XCODE_BUILD_SERVER_VERSION=1.3.0
XCODE_BUILD_SERVER_SHA256=92c4bb848af5c8128d4600a93f45e49b89ed953d885c60092459303a5d80e312
# The sha256s are of shellcheck-v$SHELLCHECK_VERSION.darwin.aarch64.tar.gz and .linux.x86_64.tar.gz.
SHELLCHECK_VERSION=0.11.0
