#!/usr/bin/env bash
# The single quality gate: prints a pass/fail table and exits 0 only if every gate passes.
set -uo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/quality [--fast|--full] [--json] [--simulator <udid>] [--update-baseline]

  --fast             Format, lint, fitness checks, unit tests, unused code (Periphery), Domain/Data
                     unit line and region coverage ratchets (default).
  --full             Everything in --fast, plus UI tests, app coverage and per-file floor.
  --json             Also write build/quality.json.
  --simulator <udid> Simulator to test on. Default: reuse/clone "HT-<branch>", one per worktree
                     (an exported SIMULATOR_ID is ignored so worktrees never share a device).
  --update-baseline  With --fast: raise the *_UNIT_MIN ratchets to the measured coverage.

Tools in build/tools/bin (scripts/ci/install-tools.sh build/tools/bin) run before those on PATH.
Thresholds: scripts/quality-thresholds.env. Per-file floor exceptions: scripts/coverage-exceptions.txt.
Exit codes: 0 all gates passed, 1 a gate failed, 2 usage error.
EOF
}

MODE="fast"
JSON=""
UPDATE_BASELINE=""
SIMULATOR=""

while [ $# -gt 0 ]; do
  case "$1" in
    --fast | --full) MODE="${1#--}" ;;
    --json) JSON="build/quality.json" ;;
    --update-baseline) UPDATE_BASELINE=1 ;;
    --simulator)
      [ $# -ge 2 ] || { usage >&2 && exit 2; }
      SIMULATOR="$2"
      shift
      ;;
    -h | --help) usage && exit 0 ;;
    *) usage >&2 && exit 2 ;;
  esac
  shift
done

if [ -n "$UPDATE_BASELINE" ] && [ "$MODE" = "full" ]; then
  echo "error: --update-baseline needs --fast (the ratchets measure unit-only coverage)" >&2
  exit 2
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LIB="$ROOT/scripts/lib"
RESULT="build/Test.xcresult"
cd "$ROOT" || exit 1
# shellcheck source=lib/tools-path.sh
source "$LIB/tools-path.sh" || exit 1
prepend_tools_path "$ROOT"
# shellcheck source=quality-thresholds.env
source scripts/quality-thresholds.env

"$ROOT/scripts/doctor" || exit 1
mkdir -p build
rows=""

# row <name> <value> <comparator> <threshold> <passed>
row() {
  rows+="$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"$5"$'\n'
}

# count_row <name> <count or empty>: a "<= 0" gate; an empty count is reported as n/a.
count_row() {
  if [ -z "$2" ]; then
    row "$1" "n/a" "<=" 0 false
  elif [ "$2" -eq 0 ]; then
    row "$1" 0 "<=" 0 true
  else
    row "$1" "$2" "<=" 0 false
  fi
}

# percent_row <name> <percent or empty> <threshold>: a ">= threshold" gate; empty is reported as n/a.
percent_row() {
  if [ -z "$2" ]; then
    row "$1" "n/a" ">=" "$3" false
  else
    row "$1" "$(printf '%.2f' "$2")" ">=" "$3" "$(awk -v v="$2" -v t="$3" 'BEGIN { print (v >= t) ? "true" : "false" }')"
  fi
}

echo "Format: swiftformat --lint"
format_out="$(swiftformat . --lint --swift-version 6 2>&1)"
grep 'error:' <<<"$format_out" >&2
count_row "Format" "$(sed -nE 's|^([0-9]+)/[0-9]+ files? requires? formatting.*|\1|p' <<<"$format_out")"

echo "Lint: swiftlint lint --strict"
lint_out="$(swiftlint lint --strict --quiet --reporter json 2>/dev/null)"
jq -r '.[] | "\(.file):\(.line): \(.severity): \(.reason) (\(.rule_id))"' <<<"$lint_out" >&2
count_row "Lint" "$(jq 'length' <<<"$lint_out" 2>/dev/null)"

echo "Fitness: scripts/fitness/run"
fitness_out="$(scripts/fitness/run 2>&1)"
grep -vE '^[0-9]+ violation\(s\)$' <<<"$fitness_out" >&2
count_row "Fitness" "$(sed -nE 's/^([0-9]+) violation\(s\)$/\1/p' <<<"$fitness_out")"

if [ -z "$SIMULATOR" ]; then
  branch="$(git rev-parse --abbrev-ref HEAD)"
  SIMULATOR="$("$LIB/simulator.sh" "HT-${branch//\//-}")" || exit 1
fi

# Each bundle runs on its own so the Domain/Data ratchets can measure unit-only coverage
# in --full too; --full then merges both runs into $RESULT for app coverage and the floor.
UNIT_RESULT="$RESULT"
bundles=(HealthTrackerTests)
if [ "$MODE" = "full" ]; then
  UNIT_RESULT="build/Unit.xcresult"
  bundles+=(HealthTrackerUITests)
fi

echo "Tests: ${bundles[*]} on simulator $SIMULATOR (full log: build/xcodebuild.log)"
# On GitHub Actions, compile errors and test failures become inline PR annotations.
beautify=(xcbeautify --quieter --disable-logging)
[ "${GITHUB_ACTIONS:-}" = "true" ] && beautify+=(--renderer github-actions)
# CI fails the build on compiler warnings; locally they stay warnings so work in progress still builds.
build_settings=(-enableCodeCoverage YES)
[ "${CI:-}" = "true" ] && build_settings+=(SWIFT_TREAT_WARNINGS_AS_ERRORS=YES GCC_TREAT_WARNINGS_AS_ERRORS=YES)
# Every test run replaces the coverage profile; clearing it first means a stale one never counts.
PROFILE_DATA="build/DerivedData/Build/ProfileData"
rm -rf "$RESULT" build/Unit.xcresult build/UI.xcresult "$PROFILE_DATA"
: >build/xcodebuild.log
# Boot and wait first: launching on a still-booting clone fails every test with "Application failed preflight checks".
xcrun simctl bootstatus "$SIMULATOR" -b >/dev/null
for bundle in "${bundles[@]}"; do
  name="Unit tests"
  bundle_result="$UNIT_RESULT"
  if [ "$bundle" = "HealthTrackerUITests" ]; then
    name="UI tests"
    bundle_result="build/UI.xcresult"
  fi
  xcodebuild test \
    -scheme HealthTracker \
    -destination "platform=iOS Simulator,id=$SIMULATOR" \
    "-only-testing:$bundle" \
    -parallel-testing-enabled NO \
    -derivedDataPath build/DerivedData \
    "${build_settings[@]}" \
    -resultBundlePath "$bundle_result" 2>&1 | tee -a build/xcodebuild.log | "${beautify[@]}"
  xcrun xcresulttool get test-results tests --path "$bundle_result" >build/test-results.json 2>/dev/null
  count_row "$name" "$("$LIB/test-failures.sh" build/test-results.json "$bundle")"
  # Region coverage is unit-only like the line ratchets: read the profile before the UI run replaces it.
  if [ "$bundle" = "HealthTrackerTests" ]; then
    app="build/DerivedData/Build/Products/Debug-iphonesimulator/HealthTracker.app"
    binary="$app/HealthTracker.debug.dylib"
    [ -f "$binary" ] || binary="$app/HealthTracker"
    profiles=("$PROFILE_DATA"/*/Coverage.profdata)
    # Two lines, Domain then Data; no output (n/a) leaves both empty.
    {
      read -r domain_regions
      read -r data_regions
    } < <("$LIB/region-coverage.sh" "${profiles[0]}" "$binary" "$ROOT")
  fi
done

# Unused code: Periphery reads the index store the test build just wrote (.periphery.yml: strict).
echo "Unused code: periphery scan"
periphery_args=(scan --skip-build --index-store-path build/DerivedData/Index.noindex/DataStore --quiet)
[ "${GITHUB_ACTIONS:-}" = "true" ] && periphery_args+=(--format github-actions)
unused=""
if command -v periphery >/dev/null; then
  periphery_out="$(periphery "${periphery_args[@]}" 2>&1)"
  periphery_code=$?
  findings="$(grep -E '^[^ ]+:[0-9]+:[0-9]+: warning: |^::warning ' <<<"$periphery_out")"
  unused="$(grep -c . <<<"$findings")"
  # A failed scan without findings (no index store, bad config) cannot be measured.
  if [ "$periphery_code" -ne 0 ] && [ "$unused" -eq 0 ]; then
    unused=""
    echo "$periphery_out" >&2
  else
    [ -z "$findings" ] || echo "$findings" >&2
  fi
fi
count_row "Unused code" "$unused"

if xcrun xccov view --report --json "$UNIT_RESULT" >build/unit-coverage.json 2>/dev/null; then
  rows+="$("$LIB/evaluate-coverage.sh" fast build/unit-coverage.json "$ROOT" \
    scripts/quality-thresholds.env scripts/coverage-exceptions.txt)"$'\n'
else
  row "Domain unit line coverage" "n/a" ">=" "$DOMAIN_UNIT_MIN" false
  row "Data unit line coverage" "n/a" ">=" "$DATA_UNIT_MIN" false
fi
percent_row "Domain unit region coverage" "$domain_regions" "$DOMAIN_REGION_UNIT_MIN"
percent_row "Data unit region coverage" "$data_regions" "$DATA_REGION_UNIT_MIN"

if [ "$MODE" = "full" ]; then
  if xcrun xcresulttool merge --output-path "$RESULT" "$UNIT_RESULT" build/UI.xcresult >/dev/null 2>&1 &&
    xcrun xccov view --report --json "$RESULT" >build/coverage.json 2>/dev/null; then
    rows+="$("$LIB/evaluate-coverage.sh" full build/coverage.json "$ROOT" \
      scripts/quality-thresholds.env scripts/coverage-exceptions.txt)"$'\n'
  else
    row "App line coverage" "n/a" ">=" "$APP_LINE_MIN" false
    row "Per-file floor" "n/a" ">=" "$FILE_FLOOR" false
  fi
fi

# Only a green run may raise the ratchets.
if [ -n "$UPDATE_BASELINE" ] && ! grep -q $'\tfalse$' <<<"$rows"; then
  "$LIB/update-baseline.sh" build/unit-coverage.json "$ROOT" scripts/quality-thresholds.env \
    "$domain_regions" "$data_regions"
fi

"$LIB/report.sh" "$MODE" ${JSON:+"$JSON"} <<<"${rows%$'\n'}"
