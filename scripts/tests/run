#!/usr/bin/env bash
# Runs every scripts/tests/test-*.sh, with the repo's build/tools/bin (the pinned tools) first on
# PATH when it exists; exits non-zero if any fails.
set -uo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
# scripts/lib/tools-path.sh: the pinned tools in build/tools/bin run before those on PATH,
# so the hook tests work on a Mac that has only what scripts/bootstrap installed.
# shellcheck source=../lib/tools-path.sh
source "$DIR/../lib/tools-path.sh" || exit 1
prepend_tools_path "$DIR/../.."
failed=0
total=0

for test in "$DIR"/test-*.sh; do
  total=$((total + 1))
  if "$test"; then
    printf '✓ %s\n' "$(basename "$test")"
  else
    printf '✗ %s\n' "$(basename "$test")"
    failed=$((failed + 1))
  fi
done

printf '\n%d/%d test files passed.\n' "$((total - failed))" "$total"
[ "$failed" -eq 0 ]
