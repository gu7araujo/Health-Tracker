#!/usr/bin/env bash
# Compares installed tools with the pins in scripts/tool-versions.env. Locally it also checks
# swift-lsp's setup: xcode-build-server, buildServer.json and a build in the DerivedData it points at.
# Warns locally (exit 0); fails (exit 1) when CI=true.
set -uo pipefail

# shellcheck source=tool-versions.env
source "$(dirname "$0")/tool-versions.env"

# scripts/lib/tools-path.sh: tools in build/tools/bin run before those on PATH.
# shellcheck source=lib/tools-path.sh
source "$(dirname "$0")/lib/tools-path.sh" || exit 1
prepend_tools_path "$(dirname "$0")/.."

level="warning"
[ "${CI:-}" = "true" ] && level="error"
problems=0

report() {
  printf '%s: %s\n  fix: %s\n' "$level" "$1" "$2" >&2
  problems=$((problems + 1))
}

# check <label> <command> <pinned> <installed> <fix>
check() {
  if ! command -v "$2" >/dev/null; then
    report "$1 not installed (pinned $3)" "$5"
  elif [ "$4" != "$3" ]; then
    report "$1 $4 installed, pinned $3" "$5"
  fi
}

check SwiftLint swiftlint "$SWIFTLINT_VERSION" "$(swiftlint version 2>/dev/null)" \
  "brew install swiftlint, or https://github.com/realm/SwiftLint/releases/tag/$SWIFTLINT_VERSION"
check SwiftFormat swiftformat "$SWIFTFORMAT_VERSION" "$(swiftformat --version 2>/dev/null)" \
  "brew install swiftformat, or https://github.com/nicklockwood/SwiftFormat/releases/tag/$SWIFTFORMAT_VERSION"
check Periphery periphery "$PERIPHERY_VERSION" "$(periphery version 2>/dev/null)" \
  "scripts/ci/install-tools.sh build/tools/bin (scripts/quality runs tools from there first)"
check Xcode xcodebuild "$XCODE_VERSION" "$(xcodebuild -version 2>/dev/null | awk 'NR == 1 { print $2 }')" \
  "install Xcode $XCODE_VERSION, then sudo xcode-select -s <path to that Xcode.app> (on CI: scripts/ci/select-xcode.sh)"

for tool in xcbeautify jq; do
  command -v "$tool" >/dev/null || report "$tool not installed" "brew install $tool"
done

# swift-lsp reads its build settings through xcode-build-server; CI runs no LSP.
if [ "$level" = "warning" ]; then
  build_server="$(dirname "$0")/../buildServer.json"
  command -v xcode-build-server >/dev/null || report "xcode-build-server not installed" "scripts/bootstrap"
  if [ ! -f "$build_server" ]; then
    report "buildServer.json missing (swift-lsp diagnostics are unreliable without it)" "scripts/bootstrap"
  else
    build_root="$(sed -n 's/.*"build_root": "\(.*\)".*/\1/p' "$build_server")"
    build_fix="build the app once (Xcode or the Xcode MCP BuildProject); swift-lsp reads that build's settings and index"
    if [ ! -d "$build_root" ]; then
      report "buildServer.json points at $build_root, which does not exist" "scripts/bootstrap, then $build_fix"
    # `xcode-build-server config` creates the dir; only a build leaves a log in it.
    elif ! compgen -G "$build_root/Logs/Build/*.xcactivitylog" >/dev/null; then
      report "buildServer.json points at $build_root, which holds no build yet" "$build_fix"
    fi
  fi
fi

if [ "$problems" -gt 0 ] && [ "$level" = "error" ]; then
  exit 1
fi
exit 0
