# Quality gate thresholds for scripts/quality. Lowering one is a visible, reviewed diff.
# Set from the lower of the local (iOS 26.5/27.0) and CI (xcode-27, iOS 27.0) measurements, on each section's date.

# --full (unit + UI tests), 2026-10-22.
APP_LINE_MIN=95.0
FILE_FLOOR=85.0

# --fast (unit tests only), 2026-10-29. Raised by `scripts/quality --fast --update-baseline`, never lowered.
# Measured after #50 stopped the unit-test host from running production startup: three local runs and CI agree
# (Domain 100.00 / 100.00, Data 97.86 / 96.83), so coverage no longer varies run to run.
DOMAIN_UNIT_MIN=100.0
DATA_UNIT_MIN=97.8
# Region coverage (llvm-cov on the unit run's profile).
DOMAIN_REGION_UNIT_MIN=100.0
DATA_REGION_UNIT_MIN=96.8
