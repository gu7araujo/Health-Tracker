# Quality gate thresholds for scripts/quality. Lowering one is a visible, reviewed diff.
# Set from the lower of the local (iOS 26.5/27.0) and CI (xcode-27, iOS 27.0) measurements, 2026-10-22.

# --full (unit + UI tests)
APP_LINE_MIN=95.0
FILE_FLOOR=85.0

# --fast (unit tests only). Ratchets toward 95.0: raised by `scripts/quality --fast --update-baseline`, never lowered.
DOMAIN_UNIT_MIN=98.4
DATA_UNIT_MIN=98.3
# Region coverage (llvm-cov on the unit run's profile), lower of local and CI (iOS 27.0), 2026-10-28.
DOMAIN_REGION_UNIT_MIN=97.3
DATA_REGION_UNIT_MIN=96.8
