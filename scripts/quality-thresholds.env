# Quality gate thresholds for scripts/quality. Lowering one is a visible, reviewed diff.
# Set from the lower of the local (iOS 26.5/27.0) and CI (xcode-27, iOS 27.0) measurements, on each section's date.

# --full (unit + UI tests), 2026-10-22.
APP_LINE_MIN=95.0
FILE_FLOOR=85.0

# --fast (unit tests only), 2026-10-28. Raised by `scripts/quality --fast --update-baseline`, never lowered. It reads
# one run, and Data coverage varies run to run on the same code: keep each value at or below the lower of local and CI.
DOMAIN_UNIT_MIN=98.4
DATA_UNIT_MIN=98.3
# Region coverage (llvm-cov on the unit run's profile).
DOMAIN_REGION_UNIT_MIN=97.3
DATA_REGION_UNIT_MIN=96.8
